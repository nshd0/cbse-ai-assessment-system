# ============================================================
# CBSE AI Assessment System — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit your actual .env file to version control.
# ============================================================

# ---- App ----
VITE_APP_NAME="CBSE AI Assessment System"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"   # development | production

# ---- API Base URL (when backend is connected) ----
# VITE_API_BASE_URL="https://api.your-domain.com"

# ---- Supabase (optional backend) ----
# VITE_SUPABASE_URL="https://xxxx.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ---- Firebase (optional auth) ----
# VITE_FIREBASE_API_KEY="your-firebase-api-key"
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"

# ---- Google Analytics (optional) ----
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ---- Feature Flags ----
VITE_ENABLE_PDF_EXPORT="true"
VITE_ENABLE_EXCEL_EXPORT="true"
VITE_ENABLE_ADMIN_PANEL="false"
